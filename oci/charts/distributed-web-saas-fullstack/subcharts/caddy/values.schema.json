{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "volumes": {
      "type": "array"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
    },
    "frontendService": {
      "enum": [
        "frontend-router",
        "console"
      ]
    },
    "gatewayEnabled": {
      "type": "boolean"
    },
    "httpOnly": {
      "type": "boolean"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "LoadBalancer"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consoleHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "accountsHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "billingHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "required": [
        "consoleHost",
        "accountsHost",
        "billingHost"
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consoleSecret": {
          "type": "string"
        },
        "accountsSecret": {
          "type": "string"
        },
        "billingSecret": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "web-saas-common": {
      "type": "object"
    }
  }
}
