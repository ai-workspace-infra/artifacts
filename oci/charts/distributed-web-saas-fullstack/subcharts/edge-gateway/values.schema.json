{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "volumes": {
      "type": "array"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "deploymentProfile": {
      "enum": [
        "independent",
        "grouped"
      ]
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,29}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "autoscaling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "minReplicas": {
                "type": "integer",
                "minimum": 1
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 1
              },
              "metrics": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "enabled",
              "minReplicas",
              "maxReplicas",
              "metrics"
            ]
          }
        },
        "required": [
          "members",
          "replicas"
        ]
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth",
        "admin",
        "core"
      ],
      "properties": {
        "auth": {
          "$ref": "#/definitions/workload"
        },
        "admin": {
          "$ref": "#/definitions/workload"
        },
        "core": {
          "$ref": "#/definitions/workload"
        }
      }
    },
    "web-saas-common": {
      "type": "object"
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "probes": {
          "type": "object"
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "metrics": {
              "type": "array",
              "minItems": 1
            }
          },
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "metrics"
          ]
        },
        "securityContext": {
          "type": "object"
        },
        "volumeMounts": {
          "type": "array"
        },
        "extraPorts": {
          "type": "array"
        },
        "volumes": {
          "type": "array"
        }
      },
      "required": [
        "image",
        "port",
        "replicas",
        "resources",
        "probes",
        "autoscaling"
      ]
    }
  }
}
