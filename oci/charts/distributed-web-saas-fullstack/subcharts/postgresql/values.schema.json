{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "volumes": {
      "type": "array"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "existingSecret": {
      "type": "string"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "existingClaim": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "pgdata": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "className",
        "size",
        "existingClaim",
        "mountPath",
        "pgdata"
      ]
    },
    "resources": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
        },
        "port": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        },
        "env": {
          "type": "array"
        }
      }
    },
    "web-saas-common": {
      "type": "object"
    }
  }
}
