{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "volumes": {
      "type": "array"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "existingSecret": {
      "type": "string"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1
    },
    "identityAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "pattern": "^$|^[a-z_][a-z0-9_]{0,62}$" },
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string" }
          },
          "required": ["username", "existingSecret", "secretKey"]
        },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string" },
            "tables": { "$ref": "#/definitions/qualifiedObjects" },
            "sequences": { "$ref": "#/definitions/qualifiedObjects" }
          },
          "required": ["username", "existingSecret", "secretKey", "tables", "sequences"]
        },
        "auditor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string" },
            "views": { "$ref": "#/definitions/qualifiedObjects" }
          },
          "required": ["username", "existingSecret", "secretKey", "views"]
        }
      },
      "required": ["enabled"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "existingClaim": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "pgdata": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "className",
        "size",
        "existingClaim",
        "mountPath",
        "pgdata"
      ]
    },
    "resources": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "username": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "image": {
          "type": "string",
          "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
        },
        "port": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "annotations": { "type": "object" }
          }
        },
        "env": {
          "type": "array"
        }
      }
    },
    "web-saas-common": {
      "type": "object"
    }
  },
  "definitions": {
    "qualifiedObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
        },
        "required": ["schema", "name"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identityAccounts": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
        },
        "required": ["identityAccounts"]
      },
      "then": {
        "properties": {
          "identityAccounts": {
            "required": ["root", "operator", "auditor"],
            "properties": {
              "root": {
                "required": ["username", "existingSecret", "secretKey"],
                "properties": { "username": { "minLength": 1 }, "existingSecret": { "minLength": 1 }, "secretKey": { "minLength": 1 } }
              },
              "operator": {
                "required": ["username", "existingSecret", "secretKey", "tables", "sequences"],
                "properties": { "username": { "minLength": 1 }, "existingSecret": { "minLength": 1 }, "secretKey": { "minLength": 1 } }
              },
              "auditor": {
                "required": ["username", "existingSecret", "secretKey", "views"],
                "properties": { "username": { "minLength": 1 }, "existingSecret": { "minLength": 1 }, "secretKey": { "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  ]
}
