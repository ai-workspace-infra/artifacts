{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "volumes": {
      "type": "array"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^([^ @]+@sha256:[a-f0-9]{64})?$"
    },
    "resources": {
      "type": "object"
    },
    "web-saas-common": {
      "type": "object"
    },
    "connect": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9._-]+:[0-9]+$"
    },
    "existingSecret": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "allowedCIDRs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    }
  }
}
