{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "domain": { "type": "string" },
    "vault": {
      "type": "object",
      "properties": {
        "image": { "type": "object" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "apiAddr": {
          "type": "string",
          "pattern": "^$|^https?://[^/ ]+/?$"
        },
        "devRootToken": { "type": "string" }
      },
      "required": ["image", "port", "apiAddr", "devRootToken"]
    },
    "zitadelDb": { "type": "object" },
    "service": { "type": "object" },
    "persistence": { "type": "object" }
  },
  "required": ["vault"]
}
